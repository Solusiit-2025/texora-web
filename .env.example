# Environment Configuration Template
# PT. Texora Visi Prima - E-Commerce & CRM Suite

# 1. DATABASE
DATABASE_URL="postgresql://texora_user:texora_secure_password@localhost:5432/texora_db?schema=public"

# 2. NEXTAUTH / AUTHENTICATION
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 3. CLOUD STORAGE (High-Res Sublimation Artwork Files)
# Cloudflare R2 / AWS S3 Compatible
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_NAME="texora-sublimation-artwork"
STORAGE_PUBLIC_URL="https://assets.texora.co.id"

# 4. PAYMENT GATEWAY (Midtrans / Xendit)
PAYMENT_SERVER_KEY=""
PAYMENT_CLIENT_KEY=""
PAYMENT_IS_PRODUCTION=false

# 5. ERP & EXTERNAL INTEGRATIONS
ERP_API_BASE_URL="https://erp.texora.co.id/api/v1"
ERP_API_KEY=""
ERP_WEBHOOK_SECRET=""

# 6. SOCIAL MEDIA WEBHOOKS
TIKTOK_WEBHOOK_SECRET=""
META_WEBHOOK_SECRET=""

# 7. GOOGLE GEMINI AI
GEMINI_API_KEY=""

# 8. NOTIFICATION SERVICE (Email & WhatsApp Gateway)
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="PT. Texora Visi Prima <no-reply@texora.co.id>"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Provider: "fonnte" atau "meta"
WHATSAPP_PROVIDER="fonnte"
# Khusus Fonnte — ambil dari dashboard fonnte.com (menu Developer)
FONTE_API_KEY=""
FONTE_DEVICE_ID=""
