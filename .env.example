# Environment Configuration Template
# PT. Texora Visi Prima - E-Commerce & CRM Suite

# 1. DATABASE
DATABASE_URL="postgresql://texora_user:texora_secure_password@localhost:5432/texora_db?schema=public"

# 2. NEXTAUTH (TIDAK DIPAKAI — autentikasi memakai JWT kustom, lihat bagian 9b)
# Baris ini hanya kompatibilitas. JANGAN memakai nilai contoh di produksi.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 3. CLOUD STORAGE (High-Res Sublimation Artwork Files)
# Cloudflare R2 / AWS S3 Compatible
# R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_NAME="texora-sublimation-artwork"
STORAGE_PUBLIC_URL="https://assets.texora.co.id"

# 4. PAYMENT GATEWAY (Midtrans / Xendit)
PAYMENT_SERVER_KEY=""
PAYMENT_CLIENT_KEY=""
PAYMENT_IS_PRODUCTION=false

# 5. ERP & EXTERNAL INTEGRATIONS
ERP_API_BASE_URL="https://erp.texora.co.id/api/v1"
ERP_API_KEY=""
ERP_WEBHOOK_SECRET=""

# 6. SOCIAL MEDIA WEBHOOKS
TIKTOK_WEBHOOK_SECRET=""
META_WEBHOOK_SECRET=""

# 7. AI PROVIDERS (OPENCODE ZEN, GOOGLE GEMINI & 9ROUTER GATEWAY)
# Dipakai untuk: analisis sentimen sosial media DAN AI CONTENT TRANSLATION
# (terjemahan multi-bahasa konten CMS untuk pengunjung asing - lihat docs/I18N-MULTIBAHASA.md).
# Kosong = fitur AI nonaktif dengan aman (konten tetap Bahasa Indonesia).
#
# ===== OPENCODE ZEN (direkomendasikan bila sudah berlangganan OpenCode) =====
# Ambil API key di https://opencode.ai/auth (menu API Keys / Zen).
# Endpoint OpenAI-compatible: https://opencode.ai/zen/v1/chat/completions
# Catatan: Zen bersifat pay-per-request (isi kredit di dashboard OpenCode).
OPENCODE_API_KEY="oc_sk_244becb01d3d_1JggkyjL6NyP6IfzEzrRsuzw0zFzy292"
OPENCODE_BASE_URL="https://opencode.ai/zen/v1"
# Model tercepat & murah untuk terjemahan. Alternatif:
# deepseek-v4-flash, glm-5.3-flash, kimi-k3, minimax-m2.5, big-pickle
OPENCODE_MODEL="deepseek-v4.1-flash"
#
# Cara ambil key Google AI Studio: https://aistudio.google.com/apikey
# Format key: "AIza..." (prefix ini membuat sistem otomatis memakai Google SDK).
GEMINI_API_KEY=""
# Model Gemini yang dipakai.
# PENTING: "gemini-2.5-flash" sudah DITOLAK Google untuk akun baru (404
# "no longer available to new users"). "gemini-3.5-flash" sering 503 high demand.
# Yang stabil: gemini-3.5-flash-lite.
# Daftar model: https://aistudio.google.com/app/prompts
GEMINI_MODEL="gemini-3.5-flash-lite"
# Jeda minimal antar panggilan Gemini (free tier ~15 request/menit).
# Naikkan kalau memakai kuota berbayar. Default 5000ms.
GEMINI_MIN_CALL_GAP_MS="5000"

# URUTAN FALLBACK AI (pemisah koma, tanpa spasi).
# "opencode" = OpenCode Zen (OPENCODE_API_KEY) - OpenAI-compatible
# "google"   = Google GenAI SDK (GEMINI_API_KEY)
# "9router"  = 9Router OpenAI-compatible (NINEROUTER_*)
# Kalau provider pertama gagal (503/401), sistem otomatis pindah ke berikutnya.
AI_PROVIDER_ORDER="opencode,google,9router"

# OPSI ALTERNATIF: 9Router AI Gateway (OpenAI-Compatible AI Gateway)
# Dipakai sebagai cadangan (fallback) kalau Google sedang high-demand.
# CATATAN: isi CLIENT TOKEN 9Router (tab Endpoints/Dashboard), BUKAN key provider.
# Base URL TANPA /chat/completions (kode menambahkannya sendiri).
# Client token 9Router lokal & model yang tersedia bisa dicek di:
#   http://localhost:20128/dashboard   dan   http://localhost:20128/v1/models
NINEROUTER_API_KEY=""
NINEROUTER_BASE_URL="http://localhost:20128/v1"
# Contoh model yang tersedia di gateway lokal: oc/big-pickle, myCombos1,
# myComboFree, cmc/ling-3.0-flash-free
NINEROUTER_MODEL="oc/big-pickle"

# CATATAN COMMANDCODE (langganan CommandCode, endpoint OpenAI-compatible):
#   base url  : https://api.commandcode.ai/provider/v1
#   key       : ~/.commandcode/auth.json  (field "apiKey")
#   model     : minimax/minimax-m3.1-flash:free, poolside/laguna-s-2.1-free, dll
# Model gratis CommandCode TIDAK bisa dipakai via key langganan biasa ->
# API membalas "You have insufficient credits" (saldo 0). Butuh top-up kredit
# di dashboard CommandCode. Setelah itu, pakai 9Router (tambah provider
# CommandCode di dashboard 9Router) atau set NINEROUTER_BASE_URL ke CommandCode.


# 8. NOTIFICATION SERVICE (Email & WhatsApp Gateway)
# Untuk Gmail: buat App Password di myaccount.google.com → Security → 2FA → App passwords
# SMTP_HOST="smtp.gmail.com" | SMTP_PORT=465 | SMTP_USER=email akun | SMTP_PASSWORD=App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="ajanto0807@gmail.com"
SMTP_PASSWORD="zykv gqkn ctow syqq"
SMTP_FROM="XoraMateria Sales <ajanto0807@gmail.com>"

# Tujuan notifikasi email tiap ada RFQ baru masuk (dipisah koma bila lebih dari satu)
QUOTE_EMAIL_TO="ajanto0807@gmail.com"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Provider: "fonnte" atau "meta"
WHATSAPP_PROVIDER="fonnte"
# Khusus Fonnte — ambil dari dashboard fonnte.com (menu Developer)
FONTE_API_KEY=""
FONTE_DEVICE_ID=""

# 9. AUTENTIKASI DUA FAKTOR (2FA / TOTP)
# Secret terpisah untuk token challenge 2FA saat login (WAJIB diubah di produksi)
JWT_2FA_SECRET="ganti-dengan-random-string-minimal-32-karakter"
# Masa berlaku token challenge 2FA
JWT_2FA_EXPIRES_IN="5m"

# 9b. SECRET JWT SESI (WAJIB di produksi — jangan pakai nilai contoh)
# Buat dengan: openssl rand -base64 48
# Tanpa nilai ini, aplikasi menolak menandatangani token di produksi
# (mencegah pemalsuan token admin).
JWT_SECRET=""
JWT_REFRESH_SECRET=""
# true = izinkan password demo bawaan (XoraMateria2026! dll.) untuk akun yang
# belum punya passwordHash. JANGAN diaktifkan di produksi.
ALLOW_DEFAULT_DEMO_PASSWORDS="false"
# Secret untuk seeding data demo via POST /api/admin/seed-social
# (header: x-seed-secret). Tanpa nilai ini, endpoint hanya bisa dipakai
# oleh sesi ADMINISTRATOR. Buat dengan: openssl rand -base64 48
SEED_SECRET=""

# 10. BACKUP DATABASE OTOMATIS
# true = scheduler in-process aktif (backup tiap 24 jam, retensi 14 file terbaru)
BACKUP_AUTO_ENABLED="true"
# Secret untuk memanggil endpoint /api/cron/backup dari cron job eksternal.
# Header yang dikirim: x-cron-secret: <nilai di bawah>
CRON_SECRET=""

# 11. URL PUBLIK SITUS (untuk sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL="https://xoramateria.com"

# 12. RATE LIMIT LOGIN (anti brute force)
# Maks percobaan login per IP dalam satu window. Default: 5 / 15 menit.
# Naikkan hanya untuk environment testing/automation.
LOGIN_RATE_LIMIT_MAX="5"
LOGIN_RATE_LIMIT_WINDOW_MS="900000"
# Maks percobaan verifikasi kode 2FA per IP. Default: 8 / 10 menit.
LOGIN_RATE_LIMIT_2FA_MAX="8"
# Maks pendaftaran akun per IP (anti bot pembuat akun massal). Default: 5 / jam.
REGISTER_RATE_LIMIT_MAX="5"
REGISTER_RATE_LIMIT_WINDOW_MS="3600000"

# 13. VERIFIKASI SEARCH ENGINE & ANALYTICS
# Ambil nilainya dari dashboard masing-masing lalu isi di sini.
# Google Search Console -> Properti -> Verifikasi -> Tag HTML
GOOGLE_SITE_VERIFICATION=""
# Bing Webmaster Tools -> Sites -> Add site -> Import from GSC / tag meta
BING_SITE_VERIFICATION=""
# Yandex Webmaster -> Verification
YANDEX_SITE_VERIFICATION=""
# Pinterest -> Settings -> Claim -> meta tag
PINTEREST_SITE_VERIFICATION=""
# Facebook Business Manager -> Settings -> Brand Safety
FACEBOOK_DOMAIN_VERIFICATION=""
# Naver Webmaster (untuk optimize untuk mesin pencari Korea)
NAVER_SITE_VERIFICATION=""
# Google Analytics 4 measurement ID (G-XXXXXXXXXX)
GOOGLE_ANALYTICS_ID=""
# Google Tag Manager container ID (GTM-XXXXXXX)
GOOGLE_TAG_MANAGER_ID=""
