// Prisma Schema for PT. Texora Visi Prima - E-Commerce & CRM Platform
// Mengacu pada PRD: PRD_Texora_Visi_Prima_Ecommerce_CRM.docx

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------
// 1. AUTENTIKASI & ROLE-BASED ACCESS CONTROL (RBAC)
// -----------------------------------------------------------

enum Role {
  CUSTOMER
  SALES_REP
  WAREHOUSE_STAFF
  ADMINISTRATOR
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String?
  phoneNumber   String?
  companyName   String?
  taxId         String?        // NPWP untuk B2B
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  orders        Order[]
  designs       CustomDesign[]
  assignedLeads Lead[]         @relation("AssignedSalesRep")
  activities    ActivityLog[]
  customerLeads Lead[]         @relation("CustomerLeads")
  auditLogs     AuditLog[]
  whatsAppConversations WhatsAppConversation[]

  @@map("users")
}

// -----------------------------------------------------------
// 2. KATALOG KAIN & HARGA TIER
// -----------------------------------------------------------

model FabricProduct {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  description      String
  composition      String          // e.g., "100% Polyester", "Dryfit Milano"
  weaveType        String?         // Knit / Woven
  widthInch        Float           // Lebar kain (misal: 60 inch / 152 cm)
  isSublimationReady Boolean       @default(true)
  basePricePerMeter Decimal        @db.Decimal(12, 2)
  thumbnailUrl     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  variants         FabricVariant[]
  priceTiers       PriceTier[]

  @@map("fabric_products")
}

model FabricVariant {
  id             String          @id @default(cuid())
  productId      String
  product        FabricProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  gsm            Int             // Grams per Square Meter (misal: 130 GSM, 180 GSM)
  colorName      String          // White Base / Raw Optic
  stockMeters    Float           @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  orderItems     OrderItem[]
  inventoryRolls InventoryRoll[]

  @@map("fabric_variants")
}

model PriceTier {
  id         String        @id @default(cuid())
  productId  String
  product    FabricProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  minMeters  Float         // Misal: 50 meter
  maxMeters  Float?        // Misal: 500 meter (null untuk unlimited tier tertinggi)
  unitPrice  Decimal       @db.Decimal(12, 2)

  @@map("price_tiers")
}

// -----------------------------------------------------------
// 3. CUSTOM SUBLIMATION DESIGN
// -----------------------------------------------------------

enum DesignStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model CustomDesign {
  id             String        @id @default(cuid())
  customerId     String
  customer       User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title          String
  fileUrl        String        // Vector / High-Res Raster (Cloudflare R2 / S3)
  fileName       String
  fileSizeBytes  BigInt
  dpi            Int?          // Minimal 150-300 DPI untuk sublimasi
  printWidthCm   Float
  printHeightCm  Float
  status         DesignStatus  @default(PENDING_REVIEW)
  proofNotes     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orderItems     OrderItem[]

  @@map("custom_designs")
}

// -----------------------------------------------------------
// 4. ORDER MANAGEMENT SYSTEM (OMS)
// -----------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PRODUCTION      // Proses printing & heat press sublimasi
  QUALITY_CONTROL
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  EXPIRED
  REFUNDED
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique // e.g., "TEX-202610-001"
  customerId      String
  customer        User          @relation(fields: [customerId], references: [id])
  totalAmount     Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @db.Decimal(12, 2) @default(0)
  shippingAmount  Decimal       @db.Decimal(12, 2) @default(0)
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   String?       // Virtual Account, QRIS, Bank Transfer
  trackingNumber  String?       // Nomor resi kargo
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fabricVariantId String
  fabricVariant   FabricVariant  @relation(fields: [fabricVariantId], references: [id])
  customDesignId  String?
  customDesign    CustomDesign?  @relation(fields: [customDesignId], references: [id])
  lengthMeters    Float
  unitPrice       Decimal        @db.Decimal(12, 2)
  subtotal        Decimal        @db.Decimal(12, 2)

  @@map("order_items")
}

// -----------------------------------------------------------
// 5. CRM (CUSTOMER RELATIONSHIP MANAGEMENT)
// -----------------------------------------------------------

enum LeadStage {
  NEW_INQUIRY
  REQUIREMENT_GATHERING
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

model Lead {
  id               String       @id @default(cuid())
  title            String       // e.g., "Pengadaan Kain Jersey Sublim 2000m - PT Garment XYZ"
  customerId       String?
  customer         User?        @relation("CustomerLeads", fields: [customerId], references: [id])
  contactPerson    String
  companyName      String?
  email            String
  phone            String
  estimatedValue   Decimal?     @db.Decimal(12, 2)
  stage            LeadStage    @default(NEW_INQUIRY)
  assignedSalesId  String?
  assignedSales    User?        @relation("AssignedSalesRep", fields: [assignedSalesId], references: [id])
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  activities       ActivityLog[]

  @@map("leads")
}

enum ActivityType {
  NOTE
  PHONE_CALL
  WHATSAPP_MESSAGE
  EMAIL
  MEETING
  SAMPLE_FABRIC_SENT
}

model ActivityLog {
  id          String       @id @default(cuid())
  leadId      String?
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String       // Sales / Admin yang mencatat
  user        User         @relation(fields: [userId], references: [id])
  type        ActivityType
  description String
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  @@map("activity_logs")
}

// -----------------------------------------------------------
// 6. LOGISTIK & GUDANG (WAREHOUSE)
// -----------------------------------------------------------

model InventoryRoll {
  id              String        @id @default(cuid())
  rollBarcode     String        @unique // e.g., "ROL-DRYFIT-00129"
  fabricVariantId String
  fabricVariant   FabricVariant @relation(fields: [fabricVariantId], references: [id])
  initialMeters   Float
  currentMeters   Float
  warehouseLocation String      // e.g., "Rak B-03, Gudang Utama"
  receivedDate    DateTime      @default(now())

  @@map("inventory_rolls")
}

// -----------------------------------------------------------
// 7. SOCIAL MEDIA COMMENT COLLECTOR & AI ANALYZER
// -----------------------------------------------------------

enum SocialPlatform {
  TIKTOK
  INSTAGRAM
  FACEBOOK
}

// -----------------------------------------------------------
// 8. WHATSAPP BUSINESS INBOX
// -----------------------------------------------------------

enum WhatsAppStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppConversation {
  id            String          @id @default(cuid())
  customerId    String?
  customer      User?           @relation(fields: [customerId], references: [id])
  contactName   String
  contactNumber String          // international format e.g. "+6287889856066"
  companyName   String?
  unreadCount   Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  messages      WhatsAppMessage[]

  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id          String           @id @default(cuid())
  conversationId String
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  from        String           // sender phone number
  to          String           // recipient phone number
  text        String
  direction   String           // "inbound" | "outbound"
  status      WhatsAppStatus   @default(SENT)
  createdAt   DateTime         @default(now())

  @@map("whatsapp_messages")
}

// -----------------------------------------------------------
// 9. SYSTEM SETTINGS (runtime-editable configuration)
// -----------------------------------------------------------

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique // e.g. "whatsapp.fonnte_api_key"
  value String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

enum CommentSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model SocialComment {
  id          String           @id @default(cuid())
  platform    SocialPlatform
  postId      String           // ID of the post/video on the platform
  commentId   String           @unique // Platform-specific unique comment ID
  username    String
  message     String
  timestamp   DateTime         @default(now()) // Time comment was received/processed
  sentiment   CommentSentiment?
  aiReply     String?         // AI-generated suggested reply
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("social_comments")
}

// -----------------------------------------------------------
// 8. AUDIT LOG
// -----------------------------------------------------------

model AuditLog {
  id          String     @id @default(cuid())
  action      String     // e.g., "CREATE_ORDER", "SOCIAL_AI_PROCESS"
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
  description String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@map("audit_logs")
}
