// Prisma Schema for PT. Texora Visi Prima - E-Commerce & CRM Platform
// Mengacu pada PRD: PRD_Texora_Visi_Prima_Ecommerce_CRM.docx

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------
// 1. AUTENTIKASI & ROLE-BASED ACCESS CONTROL (RBAC)
// -----------------------------------------------------------

enum Role {
  CUSTOMER
  SALES_REP
  WAREHOUSE_STAFF
  ADMINISTRATOR
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String?
  refreshToken  String?
  phoneNumber   String?
  companyName   String?
  taxId         String?        // NPWP untuk B2B
  role          Role           @default(CUSTOMER)
  // 2FA (TOTP) - Autentikasi Dua Faktor
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?  // Base32 secret (disimpan terenkripsi saat transit via HTTPS)
  twoFactorBackupCodes String?  // JSON array hash bcrypt (kode cadangan 10 digit)
  twoFactorEnabledAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  orders        Order[]
  designs       CustomDesign[]
  assignedLeads Lead[]         @relation("AssignedSalesRep")
  activities    ActivityLog[]
  customerLeads Lead[]         @relation("CustomerLeads")
  auditLogs     AuditLog[]
  whatsAppConversations WhatsAppConversation[]

  @@map("users")
}

// -----------------------------------------------------------
// 2. KATALOG KAIN & HARGA TIER
// -----------------------------------------------------------

model FabricProduct {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  description      String
  composition      String          // e.g., "100% Polyester", "Dryfit Milano"
  weaveType        String?         // Knit / Woven
  widthInch        Float           // Lebar kain (misal: 60 inch / 152 cm)
  isSublimationReady Boolean       @default(true)
  basePricePerMeter Decimal        @db.Decimal(12, 2)
  thumbnailUrl     String?
  category         String          @default("Sportswear")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  variants         FabricVariant[]
  priceTiers       PriceTier[]

  @@map("fabric_products")
}

model FabricVariant {
  id             String          @id @default(cuid())
  productId      String
  product        FabricProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  gsm            Int             // Grams per Square Meter (misal: 130 GSM, 180 GSM)
  colorName      String          // White Base / Raw Optic
  stockMeters    Float           @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  orderItems     OrderItem[]
  inventoryRolls InventoryRoll[]

  @@map("fabric_variants")
}

model PriceTier {
  id         String        @id @default(cuid())
  productId  String
  product    FabricProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  minMeters  Float         // Misal: 50 meter
  maxMeters  Float?        // Misal: 500 meter (null untuk unlimited tier tertinggi)
  unitPrice  Decimal       @db.Decimal(12, 2)

  @@map("price_tiers")
}

// -----------------------------------------------------------
// 3. CUSTOM SUBLIMATION DESIGN
// -----------------------------------------------------------

enum DesignStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model CustomDesign {
  id             String        @id @default(cuid())
  customerId     String
  customer       User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title          String
  fileUrl        String        // Vector / High-Res Raster (Cloudflare R2 / S3)
  fileName       String
  fileSizeBytes  BigInt
  dpi            Int?          // Minimal 150-300 DPI untuk sublimasi
  printWidthCm   Float
  printHeightCm  Float
  status         DesignStatus  @default(PENDING_REVIEW)
  proofNotes     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orderItems     OrderItem[]

  @@map("custom_designs")
}

// -----------------------------------------------------------
// 4. ORDER MANAGEMENT SYSTEM (OMS)
// -----------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PRODUCTION      // Proses printing & heat press sublimasi
  QUALITY_CONTROL
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  EXPIRED
  REFUNDED
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique // e.g., "TEX-202610-001"
  customerId      String
  customer        User          @relation(fields: [customerId], references: [id])
  totalAmount     Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @db.Decimal(12, 2) @default(0)
  shippingAmount  Decimal       @db.Decimal(12, 2) @default(0)
  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   String?       // Virtual Account, QRIS, Bank Transfer
  trackingNumber  String?       // Nomor resi kargo
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fabricVariantId String?
  fabricVariant   FabricVariant? @relation(fields: [fabricVariantId], references: [id])
  fabricName      String?
  gsm             Int?
  customDesignId  String?
  customDesign    CustomDesign?  @relation(fields: [customDesignId], references: [id])
  customDesignTitle String?
  lengthMeters    Float
  unitPrice       Decimal        @db.Decimal(12, 2)
  subtotal        Decimal        @db.Decimal(12, 2)

  @@map("order_items")
}

// -----------------------------------------------------------
// 5. CRM (CUSTOMER RELATIONSHIP MANAGEMENT)
// -----------------------------------------------------------

enum LeadStage {
  NEW_INQUIRY
  REQUIREMENT_GATHERING
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

model Lead {
  id               String       @id @default(cuid())
  title            String       // e.g., "Pengadaan Kain Jersey Sublim 2000m - PT Garment XYZ"
  customerId       String?
  customer         User?        @relation("CustomerLeads", fields: [customerId], references: [id])
  contactPerson    String
  companyName      String?
  email            String
  phone            String
  estimatedValue   Decimal?     @db.Decimal(12, 2)
  estimatedMeters  Float?
  fabricInterest   String?
  stage            LeadStage    @default(NEW_INQUIRY)
  assignedSalesId  String?
  assignedSales    User?        @relation("AssignedSalesRep", fields: [assignedSalesId], references: [id])
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  activities       ActivityLog[]

  @@map("leads")
}

enum ActivityType {
  NOTE
  PHONE_CALL
  WHATSAPP_MESSAGE
  EMAIL
  MEETING
  SAMPLE_FABRIC_SENT
}

model ActivityLog {
  id          String       @id @default(cuid())
  leadId      String?
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId      String       // Sales / Admin yang mencatat
  user        User         @relation(fields: [userId], references: [id])
  type        ActivityType
  description String
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  @@map("activity_logs")
}

// -----------------------------------------------------------
// 6. LOGISTIK & GUDANG (WAREHOUSE)
// -----------------------------------------------------------

model InventoryRoll {
  id              String         @id @default(cuid())
  rollBarcode     String         @unique // e.g., "ROL-DRYFIT-00129"
  fabricVariantId String?
  fabricVariant   FabricVariant? @relation(fields: [fabricVariantId], references: [id])
  fabricName      String?
  gsm             Int?
  batchLot        String?
  initialMeters   Float
  currentMeters   Float
  warehouseLocation String       // e.g., "Rak B-03, Gudang Utama"
  receivedDate    DateTime       @default(now())

  @@map("inventory_rolls")
}

// -----------------------------------------------------------
// 7. SOCIAL MEDIA COMMENT COLLECTOR & AI ANALYZER
// -----------------------------------------------------------

enum SocialPlatform {
  TIKTOK
  INSTAGRAM
  FACEBOOK
}

// -----------------------------------------------------------
// 8. WHATSAPP BUSINESS INBOX
// -----------------------------------------------------------

enum WhatsAppStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppConversation {
  id            String          @id @default(cuid())
  customerId    String?
  customer      User?           @relation(fields: [customerId], references: [id])
  contactName   String
  contactNumber String          // international format e.g. "+6287889856066"
  companyName   String?
  unreadCount   Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  messages      WhatsAppMessage[]

  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id          String           @id @default(cuid())
  conversationId String
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  from        String           // sender phone number
  to          String           // recipient phone number
  text        String
  direction   String           // "inbound" | "outbound"
  status      WhatsAppStatus   @default(SENT)
  createdAt   DateTime         @default(now())

  @@map("whatsapp_messages")
}

// -----------------------------------------------------------
// 9. SYSTEM SETTINGS (runtime-editable configuration)
// -----------------------------------------------------------

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique // e.g. "whatsapp.fonnte_api_key"
  value String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

enum CommentSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model SocialComment {
  id          String           @id @default(cuid())
  platform    SocialPlatform
  postId      String           // ID of the post/video on the platform
  commentId   String           @unique // Platform-specific unique comment ID
  username    String
  message     String
  timestamp   DateTime         @default(now()) // Time comment was received/processed
  sentiment   CommentSentiment?
  aiReply     String?         // AI-generated suggested reply
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("social_comments")
}

// -----------------------------------------------------------
// 8. AUDIT LOG
// -----------------------------------------------------------

model AuditLog {
  id          String     @id @default(cuid())
  action      String     // e.g., "CREATE_ORDER", "SOCIAL_AI_PROCESS"
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
  description String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())

  @@map("audit_logs")
}

// -----------------------------------------------------------
// 10. CMS & KONTEN WEBSITE (Storefront Dynamic Content)
// -----------------------------------------------------------

// Cache terjemahan AI (Gemini) untuk konten yang dikelola lewat CMS/database.
// Sumber kebenaran tetap teks Bahasa Indonesia; terjemahan hanya hasil turunan
// dan otomatis dibuat ulang (re-translate) jika teks aslinya diubah.
model ContentTranslation {
  id          String   @id @default(cuid())
  entity      String   // "hero" | "testimonial" | "faq" | "product" | "siteContent" | "pricing"
  entityId    String   // id baris / key siteContent / slug produk
  field       String   // nama kolom teks, mis. "answer", "caption", "description"
  locale      String   // en | zh | ja | de | ar (id TIDAK disimpan = default)
  source      String   @db.Text // teks Indonesia SAAT diterjemahkan (deteksi basi/stale)
  translation String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entity, entityId, field, locale])
  @@index([locale])
  // Lookup per entitas + bahasa (dipakai setiap render halaman multi-bahasa)
  @@index([entity, locale])
  @@map("content_translations")
}

model HeroSlide {
  id             String   @id @default(cuid())
  order          Int      @default(0)
  tag            String   // e.g. "Mesin Cetak Sublim Digital"
  caption        String   // Quote or highlight note
  alt            String   // SEO alt description
  mainImage      String   // Primary image URL
  secondaryImage String   // Texture / detail image URL
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("cms_hero_slides")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String   // e.g. "Budi Kurniawan"
  org       String   // e.g. "Apex Athletic Apparel, Bandung"
  quote     String   // Testimonial quote
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cms_testimonials")
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cms_faq_items")
}

// -----------------------------------------------------------
// 10b. PERMINTAAN PENAWARAN (RFQ / Request for Quote)
// Mode "web publish + CMS": pengunjung tidak checkout, tapi meminta
// penawaran harga (B2B textile: harga per roll, termin, MOQ).
// -----------------------------------------------------------

model QuoteRequest {
  id           String   @id @default(cuid())
  name         String
  company      String?
  email        String
  phone        String?
  country      String?  // negara buyer (untuk ekspor)
  productIds   String   @default("[]") @db.Text // JSON array id/slug produk
  productsText String?  @db.Text // ringkasan produk (bisa diubah admin)
  meters       Int?     // estimasi kebutuhan dalam meter
  needsSample  Boolean  @default(false) // ingin sample swatch gratis
  message      String?  @db.Text
  fileUrl      String?  // file referensi (artwork/spec) yang di-upload
  fileName     String?
  locale       String   @default("id") // bahasa halaman saat submit
  source       String   @default("website") // website | catalog | product
  status       String   @default("NEW") // NEW | CONTACTED | QUOTED | WON | LOST
  notes        String?  @db.Text // catatan internal tim sales
  leadId       String?  // relasi ke pipeline CRM
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("quote_requests")
}

// -----------------------------------------------------------
// 11b. ARTIKEL / PUSAT PANDUAN TEKSTIL (Blog B2B)
// Mode "web publish + CMS": artikel edukatif untuk menjangkau buyer
// yang belum siap menawar (top-of-funnel), sekaligus kanal internal
// linking ke halaman katalog & form Minta Penawaran.
// -----------------------------------------------------------

model Article {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String   @db.Text // ringkasan 1-2 kalimat (dipakai di card & meta description)
  body            String   @db.Text // HTML hasil RichTextEditor (disanitasi saat disimpan)
  coverImage      String?
  category        String   @default("panduan") // sportswear | hijab-fashion | home-living | merchandise | proses
  articleType     String   @default("panduan") // panduan | tips | case-study | news
  tags            String   @default("[]") @db.Text // JSON array tag
  relatedProducts String   @default("[]") @db.Text // JSON array slug produk (internal linking)
  author          String   @default("Tim Tekstil Texora")
  authorRole      String?
  readMinutes     Int      @default(4)
  seoTitle        String?
  seoDescription  String?
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, publishedAt])
  @@index([category])
  @@map("cms_articles")
}

// -----------------------------------------------------------
// 11. BACKUP DATABASE (Audit Trail & Scheduled Backup)
// -----------------------------------------------------------

model BackupLog {
  id          String   @id @default(cuid())
  filename    String   // Nama file backup di disk
  sizeBytes   BigInt   @default(0)
  tables      String   @default("[]") // JSON array nama tabel yang dibackup
  recordCount Int      @default(0)
  status      String   @default("SUCCESS") // SUCCESS | FAILED
  trigger     String   @default("MANUAL") // MANUAL | SCHEDULED
  message     String?
  createdBy   String?  // User ID yang memicu (untuk manual)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("backup_logs")
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "homepage.stats", "homepage.cta", "about.company_profile"
  value     String   @db.Text
  group     String   @default("general") // "homepage", "about", "contact", "seo"
  label     String   // Friendly label for admin UI
  updatedAt DateTime @updatedAt

  @@map("cms_site_content")
}

